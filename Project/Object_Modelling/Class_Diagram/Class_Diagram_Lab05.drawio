        <mxCell id="iC3vrILmqZfzc6Jgu8Hl-158" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fontColor=#000000;" value="Each student belongs to at most one team.&lt;br&gt;Only one advisor assignment is current per team.&lt;br&gt;A professor supervises at most four active teams.&lt;br&gt;Only the owning professor can modify their schedule.&lt;br&gt;Availability slots must not overlap, and end time must follow start time.&lt;br&gt;A slot cannot have more than one active booking.&lt;div&gt;&lt;span style=&quot;&quot;&gt;TeamStatus: Pending, Confirmed, Rejected.&lt;br style=&quot;padding: 0px; margin: 0px;&quot;&gt;ReviewDecision: Confirmed, Rejected, CorrectionRequested.&lt;/span&gt;&lt;br style=&quot;padding: 0px; margin: 0px;&quot;&gt;&lt;/div&gt;&lt;div&gt;RequestStatus: Pending, Accepted, Declined.&lt;/div&gt;" vertex="1">
